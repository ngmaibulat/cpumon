{
    "name": "etop",
    "version": "0.1.0",
    "description": "Full-screen terminal dashboard for libsysmon: CPU, memory, disk, network, processes and containers",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "etop": "./dist/cli.js"
    },
    "files": [
        "dist",
        "types"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "bun run scripts/build.ts",
        "build-watch": "bun run scripts/build.ts --watch",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "bun run build && FORCE_COLOR=3 bun test",
        "test:node": "bun run build && FORCE_COLOR=3 node --test \"test/**/*.test.js\"",
        "prepack": "bun run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ngmaibulat/cpumon.git",
        "directory": "packages/etop"
    },
    "keywords": [
        "TUI",
        "dashboard",
        "btop",
        "top",
        "htop",
        "CPU",
        "System",
        "Monitor",
        "ink"
    ],
    "author": "Aibulat",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/ngmaibulat/cpumon/issues"
    },
    "homepage": "https://github.com/ngmaibulat/cpumon#readme",
    "dependencies": {
        "libsysmon": "^0.5.0",
        "ink": "^7.1.1",
        "react": "^19.2.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/react": "^19.2.0",
        "typescript": "^7.0.2"
    }
}
