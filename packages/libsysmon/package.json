{
    "name": "libsysmon",
    "version": "0.5.2",
    "description": "System monitor library and CLI tool: CPU, memory, disk, network, processes and containers, as live output or JSON",
    "main": "bin/index.js",
    "types": "./bin/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./bin/index.d.ts",
            "default": "./bin/index.js"
        },
        "./cpu": {
            "types": "./bin/CpuMonitor.d.ts",
            "default": "./bin/CpuMonitor.js"
        },
        "./system": {
            "types": "./bin/SystemMonitor.d.ts",
            "default": "./bin/SystemMonitor.js"
        },
        "./format": {
            "types": "./bin/format.d.ts",
            "default": "./bin/format.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "bin"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "test": "bun run build && bun test",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test:node": "bun run build && node --test \"test/**/*.test.js\"",
        "build-watch": "bun run scripts/build.ts --watch",
        "build": "bun run scripts/build.ts",
        "build:types": "tsc -p tsc-types.json",
        "prepack": "bun run build && bun run build:types"
    },
    "bin": {
        "cpumon": "bin/cpumon.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ngmaibulat/cpumon.git",
        "directory": "packages/libsysmon"
    },
    "keywords": [
        "CPU",
        "System",
        "Resource",
        "Monitor",
        "Sysmon",
        "OS"
    ],
    "author": "Aibulat",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/ngmaibulat/cpumon/issues"
    },
    "homepage": "https://github.com/ngmaibulat/cpumon#readme",
    "dependencies": {
        "chalk": "^5.1.2"
    },
    "devDependencies": {
        "@types/node": "^18.19.130",
        "typescript": "^7.0.2"
    }
}
