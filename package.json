{
    "name": "cpumon-monorepo",
    "private": true,
    "description": "Workspace root for libsysmon and @aibulat/etop. Not published; see packages/",
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "bun run --filter './packages/*' build",
        "test": "bun run --filter './packages/*' --elide-lines=0 test",
        "test:node": "bun run --filter './packages/*' --elide-lines=0 test:node",
        "typecheck": "bun run --filter './packages/*' typecheck",
        "release": "bun run scripts/release.ts",
        "release:dry": "bun run scripts/release.ts --dry-run",
        "cpumon": "bun run --filter libsysmon build && node packages/libsysmon/bin/cpumon.js",
        "etop": "bun run --filter './packages/*' build && node packages/etop/dist/cli.js",
        "docs:build": "bun run --filter ./apps/* build",
        "docs:libsysmon": "bun run --filter libsysmon-docs dev",
        "docs:etop": "bun run --filter etop-docs dev"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ngmaibulat/cpumon.git"
    },
    "author": "Aibulat",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/ngmaibulat/cpumon/issues"
    },
    "homepage": "https://github.com/ngmaibulat/cpumon#readme",
    "engines": {
        "bun": ">=1.3"
    }
}
